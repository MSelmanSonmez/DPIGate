#!/bin/bash
# AppRun — entry point of the DPIGate AppImage (Linux, x86_64).
#
# Two ways to use the AppImage:
#
#   Install            (--install)   the installer path: the payload is copied out
#       of the read-only mount to ${XDG_DATA_HOME:-~/.local/share}/DPIGate/<version>/,
#       install.sh --no-build runs from that copy (setcap, firewall rules, menu
#       entry, optional start at login), and the tray is started. Later launches
#       of the same version only start the installed tray.
#
#   Run without installing   (--portable)   nothing is installed and nothing is
#       left behind. One password prompt starts a root helper that runs the
#       engine from a root-owned temporary copy under /run (the AppImage mount
#       is nosuid, so setcap cannot work there, and root cannot enter a user's
#       FUSE mount). The tray runs as the user straight from the AppImage.
#       When the tray exits, however it exits, the helper removes the firewall
#       rules, stops the engine and deletes its directory. Settings live next to
#       the AppImage in <AppImage file name>.config/ (~/.config/DPIGate when that
#       cannot be written).
#
# Started with no flag: an installed copy of this version just opens its tray;
# otherwise a dialog (a text prompt in a terminal) asks which of the two to do.
#
# The AppImage does not contain libnetfilter_queue, libnfnetlink or libmnl, and
# not the tray's GTK / AyatanaAppIndicator stack. AppRun checks for them first
# and installs missing runtime packages through linux/lib/platform.sh's
# plat_deps_install (the distribution's package manager) with ONE password
# prompt: the install path hands the password to install.sh, the portable path
# installs the packages inside the single root call that also starts the helper.
# The libraries are required. The tray is optional for an install (a warning is
# printed) and required for running without installing: an engine nobody can
# stop must not run.
#
# Usage:
#   AppRun                      installed: start the tray; else ask: install or run without installing
#   AppRun --install [flags]    copy and install (again); flags go to install.sh
#   AppRun --portable           run without installing
#   AppRun --uninstall          run the installed uninstall.sh
#   AppRun --help
#
# Any other flag is passed to install.sh and implies an install step, e.g.
# --system --start --autostart --no-autostart --no-shortcut --assume-deps --gui
# --cli --check-only.
# --assume-deps: do not install packages; missing libraries are still an error.
# --no-tray skips starting the tray (install only). --check-only never starts the
# tray and skips the dependency step.
# --dry-run (for testing) only prints the steps. With no other flag it follows the
# install path (it copies the payload but does not run install.sh) and never
# installs packages; the library check still runs. With --portable it creates
# nothing at all.
#
# Never run as root: the tray and install.sh run as the user and ask for root
# themselves when they need it.

set -e

APP_NAME="DPIGate"

HERE="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
VERSION="$(cat "$HERE/VERSION" 2>/dev/null || true)"

# Shared objects the daemon links against, by SONAME, from the host.
RUNTIME_LIBS="libnetfilter_queue.so.1 libnfnetlink.so.0 libmnl.so.0"

say() { printf '[AppRun] %s\n' "$*" >&2; }
die() { say "ERROR: $*"; exit 1; }

usage() {
    cat <<'EOF'
DPIGate AppImage

Usage:
  AppRun                      installed: open the tray; not installed: ask whether
                              to install or to run without installing
  AppRun --install [flags]    install (copy to ~/.local/share/DPIGate, setcap,
                              menu entry); flags are passed to install.sh
  AppRun --portable           run without installing: nothing is installed, nothing
                              is left behind; one password prompt; the bypass stops
                              when you choose Exit in the tray
  AppRun --uninstall          remove an installed DPIGate (runs the installed uninstall.sh)
  AppRun --help               show this help

Run without installing: settings (ProgramFilters, DNS and bypass choices) are kept in
<AppImage file name>.config/ next to the AppImage, or in ~/.config/DPIGate when that
folder cannot be written. DNS and "Bypass All Traffic" choices made in the tray are
saved and take effect the next time DPIGate is started. Only one DPIGate tray (installed
or not) can run at a time.

Runtime packages: libnetfilter_queue, libnfnetlink and libmnl are required and
are installed with the package manager if missing, with one password prompt.
The tray packages (python3 with GTK 3 and AyatanaAppIndicator3 or AppIndicator3)
are installed too. For an install a missing tray only produces a warning; for
running without installing it is an error. The compiler and -dev packages are never
installed. Use --assume-deps to skip installing packages; then missing libraries are
reported and AppRun exits 1.

install.sh flags (install path only, passed through):
  --system        install as a root/system service (systemd, OpenRC or runit)
  --start         also start goodbyedpi now
  --autostart     start the tray (and the bypass) at login
  --no-autostart  remove any login autostart entry
  --no-shortcut   do not create the application-menu entry
  --assume-deps   do not install packages (see above; also works with --portable)
  --gui / --cli   force the graphical wizard or the text installer
  --check-only    probe the system only; installs nothing

AppRun flags:
  --no-tray       do not start the tray after the install step (install only)
  --dry-run       testing: print the steps; copies the payload on the install path only

The AppImage never runs as root. It uses sudo, doas, pkexec or run0 itself when it
needs root.
EOF
}

# ── Arguments ───────────────────────────────────────────────────────────────
MODE=""             # install | portable | run (installed copy), decided below
MODE_INSTALL=0      # run install.sh (--install or any install option)
FORCE_COPY=0        # copy the payload again (--install only)
DO_UNINSTALL=0
NO_TRAY=0
DRY_RUN=0
CHECK_ONLY=0
ASSUME_DEPS=0
WANT_PORTABLE=0
WANT_INSTALL=0
INSTALL_ARGS=()
for arg in "$@"; do
    case "$arg" in
        -h|--help)   usage; exit 0 ;;
        --install)   WANT_INSTALL=1; MODE_INSTALL=1; FORCE_COPY=1 ;;
        --portable)  WANT_PORTABLE=1 ;;
        --uninstall) DO_UNINSTALL=1 ;;
        --no-tray)   NO_TRAY=1 ;;
        --dry-run)   DRY_RUN=1 ;;
        --no-build)  ;;   # implied: the AppImage ships a prebuilt binary
        --assume-deps) ASSUME_DEPS=1; INSTALL_ARGS+=("$arg") ;;
        --check-only) CHECK_ONLY=1; NO_TRAY=1; INSTALL_ARGS+=("$arg") ;;
        *)           INSTALL_ARGS+=("$arg") ;;
    esac
done

# ── Refuse root ─────────────────────────────────────────────────────────────
# Real uid, not an environment variable: a caller cannot set this away.
if [ "$(id -u)" -eq 0 ]; then
    die "do not run the DPIGate AppImage as root. Run it as your normal user;
       it asks for root (sudo/doas/pkexec/run0) when it needs it."
fi

[ -n "$VERSION" ] || die "VERSION file missing from the AppImage payload"

DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_NAME"
DATA_DIR="$DATA_ROOT"                  # where install.sh puts the runtime files
DEST="$DATA_ROOT/$VERSION"             # the payload copy this AppRun installs from

if [ "$DO_UNINSTALL" -eq 1 ]; then
    if [ "${#INSTALL_ARGS[@]}" -gt 0 ] || [ "$WANT_INSTALL" -eq 1 ] || [ "$WANT_PORTABLE" -eq 1 ]; then
        die "--uninstall cannot be combined with install options"
    fi
    if [ ! -x "$DATA_DIR/uninstall.sh" ]; then
        say "$APP_NAME is not installed in $DATA_DIR; nothing to uninstall."
        exit 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would run: $DATA_DIR/uninstall.sh"
        exit 0
    fi
    exec bash "$DATA_DIR/uninstall.sh"
fi

# ── Which mode? ─────────────────────────────────────────────────────────────
if [ "$WANT_PORTABLE" -eq 1 ]; then
    # --assume-deps (no package installs) is meaningful here; every other install.sh flag is not.
    _other=()
    for _a in ${INSTALL_ARGS[@]+"${INSTALL_ARGS[@]}"}; do
        [ "$_a" = "--assume-deps" ] || _other+=("$_a")
    done
    if [ "$WANT_INSTALL" -eq 1 ] || [ "${#_other[@]}" -gt 0 ]; then
        die "--portable cannot be combined with --install or install options (${_other[*]:-})"
    fi
    [ "$NO_TRAY" -eq 0 ] || die "--portable needs the tray: it is the only way to stop the bypass"
    MODE=portable
elif [ "$WANT_INSTALL" -eq 1 ] || [ "${#INSTALL_ARGS[@]}" -gt 0 ]; then
    MODE=install
    MODE_INSTALL=1
elif [ -f "$DEST/.installed" ]; then
    MODE=run
elif [ "$DRY_RUN" -eq 1 ]; then
    MODE=install          # a dry run follows the install path unless told otherwise
else
    MODE=""               # not installed and nothing said: ask below
fi

# ── Probes shared by every mode ─────────────────────────────────────────────
# python3 -I: the user's PYTHONPATH and the current directory are not searched.
tray_ready() {
    command -v python3 >/dev/null 2>&1 && python3 -I "$HERE/lib/tray-probe.py" >/dev/null 2>&1
}

# One tray per user. tray.py's own lock is what the tray takes; this only asks
# (a shared, non-blocking probe, rc 0 = running) and never takes it.
tray_running() {
    [ -f "$HERE/tray.py" ] && command -v python3 >/dev/null 2>&1 \
        && python3 -I "$HERE/tray.py" --check-running >/dev/null 2>&1
}

# Would this run start a tray? Then a running one means there is nothing to do.
if [ "$NO_TRAY" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && [ "$CHECK_ONLY" -eq 0 ] && tray_running; then
    say "$APP_NAME is already running (look for its tray icon); not starting a second one."
    notify-send -a "$APP_NAME" "$APP_NAME" "Already running - look for the tray icon." >/dev/null 2>&1 || true
    exit 0
fi

# ── Choose: install or run without installing ───────────────────────────────
choose_mode() {
    local have_gui=0 ans="" rc=0 i
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then have_gui=1; fi

    if [ -t 0 ] && [ -t 1 ]; then
        # A person typed this in a terminal: ask in text (same rule as install.sh).
        printf '%s is not installed.\n  1) Install                  (menu entry, setcap, optional start at login)\n  2) Run without installing   (nothing is left behind; stops when you Exit the tray)\n' "$APP_NAME" >&2
        for i in 1 2 3; do
            ans=""
            printf 'Choose [1/2, Enter to cancel]: ' >&2
            read -r ans || ans=""
            case "$ans" in
                1) MODE=install; return 0 ;;
                2) MODE=portable; return 0 ;;
                "") say "cancelled; nothing was changed."; exit 0 ;;
            esac
        done
        say "no valid choice; nothing was changed."
        exit 0
    fi

    if [ "$have_gui" -eq 1 ] && command -v zenity >/dev/null 2>&1; then
        rc=0
        ans="$(zenity --list --radiolist --title="$APP_NAME" --width=560 --height=300 \
            --text="DPIGate is not installed. What do you want to do?" \
            --column="" --column="id" --column="Choice" --hide-column=2 --print-column=2 \
            --ok-label="Continue" --cancel-label="Cancel" \
            TRUE install "Install (menu entry, setcap, optional start at login)" \
            FALSE portable "Run without installing (nothing is left behind; stops when you Exit the tray)" \
            2>/dev/null)" || rc=$?
        if [ "$rc" -eq 0 ]; then
            case "$ans" in
                install)  MODE=install;  return 0 ;;
                portable) MODE=portable; return 0 ;;
            esac
            say "cancelled; nothing was changed."; exit 0
        fi
        if [ "$rc" -eq 1 ]; then say "cancelled; nothing was changed."; exit 0; fi
        # zenity itself failed (rc other than OK/Cancel): try the next way.
    fi
    if [ "$have_gui" -eq 1 ] && command -v python3 >/dev/null 2>&1 \
       && python3 -I -c 'import gi; gi.require_version("Gtk","3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
        rc=0
        ans="$(python3 -I - <<'PYEOF' 2>/dev/null
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
d = Gtk.MessageDialog(message_type=Gtk.MessageType.QUESTION,
                      text="DPIGate is not installed. What do you want to do?")
d.set_title("DPIGate")
d.add_button("Cancel", 0)
d.add_button("Run without installing", 2)
d.add_button("Install", 1)
r = d.run()
print({1: "install", 2: "portable"}.get(r, "cancel"))
PYEOF
)" || rc=$?
        if [ "$rc" -eq 0 ]; then
            case "$ans" in
                install)  MODE=install;  return 0 ;;
                portable) MODE=portable; return 0 ;;
            esac
            say "cancelled; nothing was changed."; exit 0
        fi
    fi
    if [ "$have_gui" -eq 1 ]; then
        # A display but nothing that can ask: keep today's behavior, the install.
        say "no dialog tool (zenity or python3 with GTK 3) to ask with; installing (use --portable to run without installing)"
        notify-send -a "$APP_NAME" "$APP_NAME" "Installing. To run without installing, start with --portable." >/dev/null 2>&1 || true
        MODE=install
        return 0
    fi
    say "no terminal and no display: cannot ask. Run with --install or --portable."
    exit 2
}

if [ -z "$MODE" ]; then
    choose_mode
    if [ "$MODE" = install ]; then MODE_INSTALL=1; fi
    if [ "$MODE" = portable ] && [ "$NO_TRAY" -eq 1 ]; then
        die "running without installing needs the tray: it is the only way to stop the bypass"
    fi
fi

# ── Settings directory of the portable mode ─────────────────────────────────
# <AppImage file>.config/ next to the AppImage ($APPIMAGE is set by the AppImage
# runtime); the user's ~/.config/DPIGate when that cannot be written.
resolve_cfg_dir() {
    local d
    if [ -n "${APPIMAGE:-}" ] && [ -f "$APPIMAGE" ]; then
        d="${APPIMAGE}.config"
        if [ "$DRY_RUN" -eq 1 ]; then
            # a dry run creates nothing: only say where it would go
            if [ -d "$d" ] && [ -w "$d" ] || { [ ! -e "$d" ] && [ -w "$(dirname "$d")" ]; }; then
                printf '%s' "$d"
                return 0
            fi
        elif { [ -d "$d" ] || mkdir -p "$d" 2>/dev/null; } && [ -w "$d" ] && [ -x "$d" ]; then
            printf '%s' "$d"
            return 0
        fi
        say "WARNING: cannot write $d; keeping the settings in ${XDG_CONFIG_HOME:-$HOME/.config}/DPIGate" >&2
    fi
    printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/DPIGate"
}

# ── Load platform.sh once, in THIS shell ────────────────────────────────────
# One shell means a password cached by plat_root_acquire stays available for
# every later root step (it used to be asked again for each subshell).
# The portable mode must leave nothing under ~: its log goes into the temporary
# staging directory, or nowhere in a dry run.
STAGE=""
cleanup() {
    if [ -n "$STAGE" ] && [ -d "$STAGE" ]; then rm -rf -- "$STAGE"; fi
}
trap cleanup EXIT

if [ "$MODE" = portable ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        PLAT_LOG=/dev/null
    else
        if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
            _stage_base="$XDG_RUNTIME_DIR"
        else
            _stage_base="${TMPDIR:-/tmp}"
        fi
        STAGE="$(mktemp -d "$_stage_base/dpigate-stage.XXXXXX")" || die "cannot create a private staging directory in $_stage_base"
        chmod 0700 "$STAGE"
        PLAT_LOG="$STAGE/platform.log"
    fi
    export PLAT_LOG
fi
# shellcheck disable=SC1091
. "$HERE/lib/platform.sh" || die "cannot load lib/platform.sh from the AppImage"
PLAT_DEPS_RUNTIME_ONLY=1

# ── Runtime dependencies ────────────────────────────────────────────────────
# Missing NFQ libraries: a required dependency. Missing tray: optional for an
# install, required for running without installing.

# Prints the sonames from RUNTIME_LIBS that ldconfig does not list.
nfq_missing() {
    local ldconfig_bin cache so missing=""
    ldconfig_bin="$(command -v ldconfig 2>/dev/null || true)"
    [ -n "$ldconfig_bin" ] || ldconfig_bin=/sbin/ldconfig
    [ -x "$ldconfig_bin" ] || die "cannot find ldconfig; cannot check the runtime libraries"
    cache="$("$ldconfig_bin" -p 2>/dev/null || true)"
    for so in $RUNTIME_LIBS; do
        if ! printf '%s\n' "$cache" | awk -v s="$so" '$1 == s { found = 1 } END { exit !found }'; then
            missing="$missing $so"
        fi
    done
    printf '%s' "$missing"
}

# Runtime package names for this distribution (from platform.sh's table).
nfq_packages() {
    _plat_nfq_req_for "$(plat_pkgmgr)" 2>/dev/null || true
}

# Names the packages, then exits 1. $1 = missing sonames.
report_nfq_missing() {
    local pkgs
    pkgs="$(nfq_packages)"
    say "ERROR: runtime libraries missing:$1"
    if [ -n "$pkgs" ]; then
        say "Install these runtime packages, then run AppRun again: $pkgs"
    else
        say "Install the runtime packages of libnetfilter_queue, libnfnetlink and libmnl"
        say "(not the -dev packages) for this distribution, then run AppRun again."
    fi
    exit 1
}

report_tray_missing() {
    say "The tray needs python3 with PyGObject and GTK 3, plus AyatanaAppIndicator3 or AppIndicator3."
}

# Installs the packages of the roles in $1 ("nfq", "tray" or "nfq tray") with ONE
# root session. Returns 0 done/attempted, 2 the user declined the prompt.
install_runtime_packages() {
    local roles="$1" role rc=0
    case "$roles" in
        "nfq tray") role=appimage ;;
        nfq)        role=nfq ;;
        tray)       role=tray ;;
        *)          return 0 ;;
    esac
    plat_root_acquire || rc=$?
    if [ "$rc" -eq 2 ]; then return 2; fi
    if [ "$rc" -ne 0 ]; then say "no way to become root (sudo/doas/pkexec/run0 unusable)"; return 0; fi
    rc=0
    plat_deps_install "$role" || rc=$?
    if [ "$rc" -eq 2 ]; then return 2; fi
    if [ "$rc" -ne 0 ]; then say "package installation did not complete (rc=$rc)"; fi
    return 0
}

# Install and run paths install packages here. For MODE=portable this only sets
# NEED_PORTABLE_ROLES: the root helper installs them in its single root call.
NEED_PORTABLE_ROLES=""
check_runtime_deps() {
    local missing pkgs roles="" rc=0
    missing="$(nfq_missing)"
    if [ -n "$missing" ]; then
        pkgs="$(nfq_packages)"
        if [ "$DRY_RUN" -eq 1 ]; then
            say "would install the runtime packages: ${pkgs:-(not defined for this distribution)}"
            report_nfq_missing "$missing"
        fi
        if [ "$ASSUME_DEPS" -eq 1 ]; then
            say "--assume-deps: not installing packages"
            report_nfq_missing "$missing"
        fi
        roles="nfq"
    fi
    if ! tray_ready; then
        if [ "$DRY_RUN" -eq 1 ]; then
            say "would install the tray packages (python3 GTK 3 and AyatanaAppIndicator3 or AppIndicator3)"
        elif [ "$ASSUME_DEPS" -eq 0 ]; then
            roles="${roles:+$roles }tray"
        fi
    fi

    if [ "$MODE" = portable ]; then
        NEED_PORTABLE_ROLES="$roles"
        return 0
    fi

    if [ -n "$roles" ]; then
        if [ -n "$missing" ]; then
            say "runtime libraries missing:$missing; installing through the package manager"
        else
            say "tray packages missing; installing through the package manager"
        fi
        install_runtime_packages "$roles" || rc=$?
        if [ "$rc" -eq 2 ]; then
            say "package installation was declined; nothing was installed"
            if [ -n "$missing" ]; then report_nfq_missing "$missing"; fi
            die "cancelled: the password prompt was declined"
        fi
        missing="$(nfq_missing)"
        if [ -n "$missing" ]; then
            report_nfq_missing "$missing"
        fi
        case " $roles " in *" nfq "*) say "runtime libraries installed" ;; esac
    fi

    if tray_ready || [ "$DRY_RUN" -eq 1 ]; then
        return 0
    fi
    say "WARNING: the tray is not available. It needs python3 with PyGObject and GTK 3,"
    say "         plus AyatanaAppIndicator3 or AppIndicator3. The bypass is installed"
    say "         without the tray icon; install those packages and run AppRun again."
    return 0
}

if [ "$CHECK_ONLY" -eq 0 ]; then
    check_runtime_deps
fi

# ════════════════════════════════════════════════════════════════════════════
# Run without installing
# ════════════════════════════════════════════════════════════════════════════

# $1 = exit status of the root call; explains it and exits.
portable_failed() {
    local rc="$1"
    if [ "$rc" -eq 2 ]; then
        say "the password prompt was cancelled; nothing was changed."
        exit 0
    fi
    if [ -s "$STAGE/platform.log" ]; then
        say "details:"
        tail -n 25 "$STAGE/platform.log" >&2 || true
    fi
    case "$rc" in
        10) report_nfq_missing "$(nfq_missing)" ;;
        11) report_tray_missing; die "the bypass will not run without a tray" ;;
        12) die "the payload checksum did not match; refusing to run it as root" ;;
        13) die "no root-owned directory that can run programs (/run and /dev/shm are both unusable)" ;;
        15) die "a previous DPIGate session is still shutting down; try again in a few seconds" ;;
        *)  die "the root helper failed (exit $rc)" ;;
    esac
}

# Exit status 3: an engine that is not ours is already running. Taking it over would
# stop it (start.sh --restart) and then shut it down when the tray exits.
portable_refuse_foreign_engine() {
    local pid argv0 ours_a="/run/dpigate/" ours_b="/dev/shm/dpigate/" ours_t="${DPIGATE_TEST_BASE:-/nonexistent-}/"
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet goodbyedpi.service 2>/dev/null; then
        say "ERROR: the DPIGate system service (goodbyedpi.service) is running, so it already owns the engine and"
        say "       the firewall rules. Stop it first (sudo systemctl stop goodbyedpi) or use the installed DPIGate."
        exit 3
    fi
    for pid in $(plat_gdpi_pids); do
        # The program path is argument 0 (the binary) or, for a script run through its
        # interpreter, argument 1.
        argv0="$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | head -n 2 | tr '\n' ' ')"
        case "$argv0" in
            "$ours_a"*|"$ours_b"*|"$ours_t"*|*" $ours_a"*|*" $ours_b"*|*" $ours_t"*) continue ;;   # left by a dead earlier portable session: taken over
        esac
        say "ERROR: another goodbyedpi engine is already running (pid $pid, ${argv0:-unknown path})."
        say "       Stop it first (its tray's Exit, 'sudo systemctl stop goodbyedpi', or kill.sh), then try again."
        exit 3
    done
}

portable_main() {
    local uid cfg tarball tarsum nonce rd_candidates c state="" esc_pid="" rc=0 waited=0
    local roles="$NEED_PORTABLE_ROLES"
    uid="$(id -u)"

    cfg="$(resolve_cfg_dir)"
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would run without installing: settings in $cfg"
        say "would stage the payload, ask for root ONCE (installing: ${roles:-nothing}), start the root helper"
        say "would start: $HERE/tray-launcher.sh --portable"
        exit 0
    fi

    portable_refuse_foreign_engine
    if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
        die "--portable needs a graphical session: the tray is the only way to stop the bypass"
    fi
    if [ "$ASSUME_DEPS" -eq 1 ] && ! tray_ready; then
        report_tray_missing
        die "tray packages are missing and --assume-deps does not install them; the bypass will not run without a tray"
    fi

    # Settings (user side): the directory and the default ProgramFilters.
    mkdir -p "$cfg" 2>/dev/null || die "cannot create the settings directory $cfg"
    if [ ! -e "$cfg/ProgramFilters" ] && [ -f "$HERE/ProgramFilters" ]; then
        cp "$HERE/ProgramFilters" "$cfg/ProgramFilters" || die "cannot write $cfg/ProgramFilters"
    fi

    # The payload as ONE tar file and its SHA-256, computed from the read-only
    # AppImage mount. Root copies the tarball into its own directory and refuses
    # to run it unless the copy still has this checksum (see portable-bootstrap.sh).
    tar -C "$HERE" -cf "$STAGE/payload.tar" . || die "cannot pack the payload"
    tarball="$(readlink -f -- "$STAGE/payload.tar")"   # the bootstrap wants the canonical name
    tarsum="$(sha256sum "$tarball" | cut -d' ' -f1)"
    [ -n "$tarsum" ] || die "cannot compute the payload checksum"
    nonce="$$.$RANDOM$RANDOM"

    # ONE escalation: the password prompt (sudo: asked here once, then reused;
    # pkexec/run0: the call below asks) and then a single root call that installs
    # the packages, starts the engine and keeps watching THIS process. AppRun
    # becomes the tray with exec below, so $$ is the tray's PID; if AppRun dies
    # first, the helper tears everything down by itself.
    rc=0
    plat_root_acquire || rc=$?
    if [ "$rc" -eq 2 ]; then
        say "the password prompt was cancelled; nothing was changed."
        exit 0
    fi
    [ "$rc" -eq 0 ] || die "no way to become root (sudo, doas, pkexec and run0 are all unusable)"

    say "starting the engine${roles:+ (installing packages: $roles)}; this can take a while..."
    # /bin/bash by absolute path: the program root is asked to run is not looked up in
    # a PATH the user controls (pkexec and doas want an absolute path anyway).
    ( plat_run_root /bin/bash -c "$(cat "$HERE/portable-bootstrap.sh")" dpigate-boot \
          "$uid" "$$" "$tarball" "$tarsum" "$roles" "$cfg" "$nonce" ) </dev/null >/dev/null 2>&1 &
    esc_pid=$!

    rd_candidates="${DPIGATE_TEST_BASE:+$DPIGATE_TEST_BASE/$uid/data/state} /run/dpigate/$uid/data/state /dev/shm/dpigate/$uid/data/state"
    c=""
    while :; do
        for c in $rd_candidates; do
            if [ -f "$c" ]; then
                state="$(cat "$c" 2>/dev/null || true)"
                case "$state" in "ready "*" $nonce") break 2 ;; esac
            fi
        done
        if ! kill -0 "$esc_pid" 2>/dev/null; then
            rc=0
            wait "$esc_pid" || rc=$?
            portable_failed "$rc"
        fi
        sleep 0.5
        waited=$((waited + 1))
        if [ "$waited" -gt 1800 ]; then
            die "the engine did not come up within 15 minutes"
        fi
    done
    # c = the state file that matched: its directory is the helper's data dir.
    PORTABLE_DATA_DIR="$(dirname "$c")"

    say "engine running (pid $(echo "$state" | cut -d' ' -f2)); opening the tray. Choose Exit in the tray to stop the bypass."
    rm -rf -- "$STAGE"
    STAGE=""
    trap - EXIT
    unset SUDO_PASSWORD
    export GDPI_PORTABLE=1 GDPI_DATA_DIR="$PORTABLE_DATA_DIR" GDPI_CONFIG_DIR="$cfg"
    # The tray's platform.sh logs nowhere: nothing may appear under ~/.local/share.
    export PLAT_LOG=/dev/null PYTHONDONTWRITEBYTECODE=1
    exec bash "$HERE/tray-launcher.sh" --portable
}

if [ "$MODE" = portable ]; then
    portable_main
fi

# ════════════════════════════════════════════════════════════════════════════
# Install / installed
# ════════════════════════════════════════════════════════════════════════════

# ── Step 1: copy the payload out of the (read-only) AppImage mount ──────────
copy_payload() {
    local tmp="$DEST.partial.$$"
    rm -rf "$tmp"
    mkdir -p "$DATA_ROOT"
    if ! cp -a "$HERE/." "$tmp"; then
        rm -rf "$tmp"
        die "copying the payload to $DEST failed"
    fi
    rm -f "$tmp/.complete" "$tmp/.installed"
    rm -rf "$DEST"
    mv "$tmp" "$DEST"
    : > "$DEST/.complete"
    say "payload copied to $DEST"
}

# Copy only when forced by --install or when no complete copy exists. Install
# options (including --check-only) never replace an existing copy.
if [ "$FORCE_COPY" -eq 1 ] || [ ! -f "$DEST/.complete" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would copy the payload to $DEST"
        # Copy anyway: the copy is the only side effect, and a dry run is
        # how the "already copied, do not copy again" path gets tested.
    fi
    copy_payload
else
    say "version $VERSION already copied to $DEST"
fi

# ── Step 2: install.sh from the copy ────────────────────────────────────────
if [ "$MODE_INSTALL" -eq 1 ] || [ ! -f "$DEST/.installed" ]; then
    # A check-only run must not clear the marker of an existing install.
    if [ "$CHECK_ONLY" -eq 0 ]; then
        rm -f "$DEST/.installed"
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would run: bash $DEST/install.sh --no-build ${INSTALL_ARGS[*]:-}"
    else
        say "running install.sh from $DEST"
        # SUDO_PASSWORD (a shell variable, not exported) goes to install.sh as an
        # environment prefix, which install.sh and the wizard accept: the password
        # asked for above is not asked again.
        if ! SUDO_PASSWORD="${SUDO_PASSWORD:-}" bash "$DEST/install.sh" --no-build ${INSTALL_ARGS[@]+"${INSTALL_ARGS[@]}"}; then
            die "install.sh failed. Nothing is marked as installed; run AppRun again after fixing the reported problem."
        fi
        if [ "$CHECK_ONLY" -eq 1 ]; then
            say "--check-only: nothing was installed; not marking the install complete"
        else
            : > "$DEST/.installed"
        fi
    fi
else
    say "$APP_NAME $VERSION is already installed"
fi

# ── Step 3: start the tray ──────────────────────────────────────────────────
if [ "$NO_TRAY" -eq 1 ]; then
    say "tray not started (--no-tray or --check-only)"
    exit 0
fi
if [ "$DRY_RUN" -eq 1 ]; then
    say "would start: $DATA_DIR/tray-launcher.sh"
    exit 0
fi
[ -x "$DATA_DIR/tray-launcher.sh" ] || die "$DATA_DIR/tray-launcher.sh is missing; install step did not complete"
unset SUDO_PASSWORD
setsid "$DATA_DIR/tray-launcher.sh" </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
say "tray started"
