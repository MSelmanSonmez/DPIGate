#!/bin/bash
# AppRun — entry point of the DPIGate AppImage (Linux, x86_64).
#
# The AppImage is a read-only FUSE mount, but install.sh has to write files,
# setcap the daemon and load firewall rules. So the payload is first copied
# out of the mount to
#     ${XDG_DATA_HOME:-~/.local/share}/DPIGate/<version>/
# install.sh is run from that copy with --no-build (the binary is prebuilt),
# and the tray is started. Later launches of the same version only start the
# tray.
#
# The AppImage does not contain libnetfilter_queue, libnfnetlink or libmnl, and
# it does not contain the tray's GTK / AyatanaAppIndicator stack. Before
# anything is copied or installed, AppRun checks for them and, if they are
# missing, installs the runtime packages through linux/lib/platform.sh's
# plat_deps_install (the distribution's package manager, one password prompt).
# The libraries are required: if they cannot be installed AppRun names the
# packages and exits 1. The tray is optional: if its packages cannot be
# installed, the install continues and a warning is printed.
#
# Usage:
#   AppRun                      first run: check, copy + install; later: start the tray
#   AppRun --install [flags]    copy and install again; flags go to install.sh
#   AppRun --uninstall          run the installed uninstall.sh
#   AppRun --help
#
# Any flag this script does not know is passed to install.sh, and passing one
# implies an install step, e.g. --system --start --autostart --no-autostart
# --no-shortcut --assume-deps --gui --cli --check-only.
# --assume-deps: do not install packages; missing libraries are still an error.
# --no-tray skips starting the tray. --check-only never starts the tray and
# skips the dependency step.
# --dry-run (for testing) copies the payload but only prints the install and
# tray steps. It never installs packages; the library check still runs.
#
# Never run as root: install.sh and the tray must run as the user, and
# install.sh asks for root itself when it needs it.

set -eu

APP_NAME="DPIGate"

HERE="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
VERSION="$(cat "$HERE/VERSION" 2>/dev/null || true)"

# Shared objects the daemon links against, by SONAME, from the host.
RUNTIME_LIBS="libnetfilter_queue.so.1 libnfnetlink.so.0 libmnl.so.0"

# tray.py tries AyatanaAppIndicator3 0.1, then AppIndicator3 0.1, and needs
# GTK 3.0. This probe checks the same typelibs; exit 0 when the tray can load.
TRAY_PROBE='import gi, importlib, sys
gi.require_version("Gtk", "3.0")
importlib.import_module("gi.repository.Gtk")
for name in ("AyatanaAppIndicator3", "AppIndicator3"):
    try:
        gi.require_version(name, "0.1")
        importlib.import_module("gi.repository." + name)
        sys.exit(0)
    except (ImportError, ValueError):
        pass
sys.exit(1)'

say() { printf '[AppRun] %s\n' "$*" >&2; }
die() { say "ERROR: $*"; exit 1; }

usage() {
    cat <<'EOF'
DPIGate AppImage

Usage:
  AppRun                      first run: check, copy and install; later runs: start the tray
  AppRun --install [flags]    copy and install again; flags are passed to install.sh
  AppRun --uninstall          remove DPIGate (runs the installed uninstall.sh)
  AppRun --help               show this help

Runtime packages: libnetfilter_queue, libnfnetlink and libmnl are required and
are installed with the package manager if missing (one password prompt). The
tray packages (python3 with GTK 3 and AyatanaAppIndicator3 or AppIndicator3)
are installed too; if that fails the bypass still installs, without the icon.
The compiler and -dev packages are never installed. Use --assume-deps to skip
installing packages; then missing libraries are reported and AppRun exits 1.

install.sh flags (passed through):
  --system        install as a root/system service (systemd, OpenRC or runit)
  --start         also start goodbyedpi now
  --autostart     start the tray (and the bypass) at login
  --no-autostart  remove any login autostart entry
  --no-shortcut   do not create the application-menu entry
  --assume-deps   do not install packages (see above)
  --gui / --cli   force the graphical wizard or the text installer
  --check-only    probe the system only; installs nothing

AppRun flags:
  --no-tray       do not start the tray after the install step
  --dry-run       testing: copy the payload, print the install and tray steps only

The AppImage never runs as root. install.sh and AppRun use sudo, doas, pkexec
or run0 themselves when they need root.
EOF
}

# ── Arguments ───────────────────────────────────────────────────────────────
MODE_INSTALL=0      # run install.sh (--install or any install option)
FORCE_COPY=0        # copy the payload again (--install only)
DO_UNINSTALL=0
NO_TRAY=0
DRY_RUN=0
CHECK_ONLY=0
ASSUME_DEPS=0
INSTALL_ARGS=()
for arg in "$@"; do
    case "$arg" in
        -h|--help)   usage; exit 0 ;;
        --install)   MODE_INSTALL=1; FORCE_COPY=1 ;;
        --uninstall) DO_UNINSTALL=1 ;;
        --no-tray)   NO_TRAY=1 ;;
        --dry-run)   DRY_RUN=1 ;;
        --no-build)  ;;   # implied: the AppImage ships a prebuilt binary
        --assume-deps) ASSUME_DEPS=1; INSTALL_ARGS+=("$arg") ;;
        --check-only) CHECK_ONLY=1; NO_TRAY=1; INSTALL_ARGS+=("$arg") ;;
        *)           INSTALL_ARGS+=("$arg") ;;
    esac
done

# ── Refuse root ─────────────────────────────────────────────────────────────
# Real uid, not an environment variable: a caller cannot set this away.
if [ "$(id -u)" -eq 0 ]; then
    die "do not run the DPIGate AppImage as root. Run it as your normal user;
       install.sh asks for root (sudo/doas/pkexec/run0) when it needs it."
fi

[ -n "$VERSION" ] || die "VERSION file missing from the AppImage payload"

DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_NAME"
DATA_DIR="$DATA_ROOT"                  # where install.sh puts the runtime files
DEST="$DATA_ROOT/$VERSION"             # the payload copy this AppRun installs from

if [ "$DO_UNINSTALL" -eq 1 ]; then
    if [ "${#INSTALL_ARGS[@]}" -gt 0 ] || [ "$MODE_INSTALL" -eq 1 ]; then
        die "--uninstall cannot be combined with install options"
    fi
    if [ ! -x "$DATA_DIR/uninstall.sh" ]; then
        say "$APP_NAME is not installed in $DATA_DIR; nothing to uninstall."
        exit 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would run: $DATA_DIR/uninstall.sh"
        exit 0
    fi
    exec bash "$DATA_DIR/uninstall.sh"
fi

# Any install option means an install step is wanted.
if [ "${#INSTALL_ARGS[@]}" -gt 0 ]; then
    MODE_INSTALL=1
fi

# ── Runtime dependencies ────────────────────────────────────────────────────
# Missing NFQ libraries: a required dependency. Missing tray: optional.

# Prints the sonames from RUNTIME_LIBS that ldconfig does not list.
nfq_missing() {
    local ldconfig_bin cache so missing=""
    ldconfig_bin="$(command -v ldconfig 2>/dev/null || true)"
    [ -n "$ldconfig_bin" ] || ldconfig_bin=/sbin/ldconfig
    [ -x "$ldconfig_bin" ] || die "cannot find ldconfig; cannot check the runtime libraries"
    cache="$("$ldconfig_bin" -p 2>/dev/null || true)"
    for so in $RUNTIME_LIBS; do
        if ! printf '%s\n' "$cache" | awk -v s="$so" '$1 == s { found = 1 } END { exit !found }'; then
            missing="$missing $so"
        fi
    done
    printf '%s' "$missing"
}

# Runtime package names for this distribution (from platform.sh's table).
nfq_packages() {
    ( set +eu; . "$HERE/lib/platform.sh" >/dev/null 2>&1 && _plat_nfq_req_for "$(plat_pkgmgr)" ) 2>/dev/null || true
}

# Names the packages, then exits 1. $1 = missing sonames.
report_nfq_missing() {
    local pkgs
    pkgs="$(nfq_packages)"
    say "ERROR: runtime libraries missing:$1"
    if [ -n "$pkgs" ]; then
        say "Install these runtime packages, then run AppRun again: $pkgs"
    else
        say "Install the runtime packages of libnetfilter_queue, libnfnetlink and libmnl"
        say "(not the -dev packages) for this distribution, then run AppRun again."
    fi
    exit 1
}

tray_ready() {
    command -v python3 >/dev/null 2>&1 && python3 -I -c "$TRAY_PROBE" >/dev/null 2>&1
}

# plat_deps_install through platform.sh, in a subshell so its settings (set -u
# is not compatible with it) cannot leak into this script. $1 = role (nfq|tray).
# rc 0 ok; rc 2 the user declined the password prompt; other rc = failed.
platform_install() {
    local rc=0
    ( set +eu
      . "$HERE/lib/platform.sh" || exit 1
      PLAT_DEPS_RUNTIME_ONLY=1
      plat_root_acquire || exit $?
      plat_deps_install "$1" ) || rc=$?
    return "$rc"
}

check_runtime_deps() {
    local missing rc pkgs
    missing="$(nfq_missing)"
    if [ -n "$missing" ]; then
        pkgs="$(nfq_packages)"
        if [ "$DRY_RUN" -eq 1 ]; then
            say "would install the runtime packages: ${pkgs:-(not defined for this distribution)}"
            report_nfq_missing "$missing"
        fi
        if [ "$ASSUME_DEPS" -eq 1 ]; then
            say "--assume-deps: not installing packages"
            report_nfq_missing "$missing"
        fi
        say "runtime libraries missing:$missing; installing through the package manager"
        rc=0
        platform_install nfq || rc=$?
        if [ "$rc" -eq 2 ]; then
            say "package installation was declined; nothing was installed"
            report_nfq_missing "$missing"
        fi
        if [ "$rc" -ne 0 ]; then
            say "package installation failed (rc=$rc)"
        fi
        missing="$(nfq_missing)"
        if [ -n "$missing" ]; then
            report_nfq_missing "$missing"
        fi
        say "runtime libraries installed"
    fi

    if tray_ready; then
        return 0
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would install the tray packages (python3 GTK 3 and AyatanaAppIndicator3 or AppIndicator3)"
        return 0
    fi
    if [ "$ASSUME_DEPS" -eq 0 ]; then
        say "tray packages missing; installing through the package manager"
        rc=0
        platform_install tray || rc=$?
        [ "$rc" -eq 0 ] || say "tray package installation did not complete (rc=$rc)"
    fi
    if ! tray_ready; then
        say "WARNING: the tray is not available. It needs python3 with PyGObject and GTK 3,"
        say "         plus AyatanaAppIndicator3 or AppIndicator3. The bypass is installed"
        say "         without the tray icon; install those packages and run AppRun again."
    fi
    return 0
}

if [ "$CHECK_ONLY" -eq 0 ]; then
    check_runtime_deps
fi

# ── Step 1: copy the payload out of the (read-only) AppImage mount ──────────
copy_payload() {
    local tmp="$DEST.partial.$$"
    rm -rf "$tmp"
    mkdir -p "$DATA_ROOT"
    if ! cp -a "$HERE/." "$tmp"; then
        rm -rf "$tmp"
        die "copying the payload to $DEST failed"
    fi
    rm -f "$tmp/.complete" "$tmp/.installed"
    rm -rf "$DEST"
    mv "$tmp" "$DEST"
    : > "$DEST/.complete"
    say "payload copied to $DEST"
}

# Copy only when forced by --install or when no complete copy exists. Install
# options (including --check-only) never replace an existing copy.
if [ "$FORCE_COPY" -eq 1 ] || [ ! -f "$DEST/.complete" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would copy the payload to $DEST"
        # Copy anyway: the copy is the only side effect, and a dry run is
        # how the "already copied, do not copy again" path gets tested.
    fi
    copy_payload
else
    say "version $VERSION already copied to $DEST"
fi

# ── Step 2: install.sh from the copy ────────────────────────────────────────
if [ "$MODE_INSTALL" -eq 1 ] || [ ! -f "$DEST/.installed" ]; then
    # A check-only run must not clear the marker of an existing install.
    if [ "$CHECK_ONLY" -eq 0 ]; then
        rm -f "$DEST/.installed"
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
        say "would run: bash $DEST/install.sh --no-build ${INSTALL_ARGS[*]:-}"
    else
        say "running install.sh from $DEST"
        if ! bash "$DEST/install.sh" --no-build ${INSTALL_ARGS[@]+"${INSTALL_ARGS[@]}"}; then
            die "install.sh failed. Nothing is marked as installed; run AppRun again after fixing the reported problem."
        fi
        if [ "$CHECK_ONLY" -eq 1 ]; then
            say "--check-only: nothing was installed; not marking the install complete"
        else
            : > "$DEST/.installed"
        fi
    fi
else
    say "$APP_NAME $VERSION is already installed"
fi

# ── Step 3: start the tray ──────────────────────────────────────────────────
if [ "$NO_TRAY" -eq 1 ]; then
    say "tray not started (--no-tray or --check-only)"
    exit 0
fi
if [ "$DRY_RUN" -eq 1 ]; then
    say "would start: $DATA_DIR/tray-launcher.sh"
    exit 0
fi
[ -x "$DATA_DIR/tray-launcher.sh" ] || die "$DATA_DIR/tray-launcher.sh is missing; install step did not complete"
setsid "$DATA_DIR/tray-launcher.sh" </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
say "tray started"
