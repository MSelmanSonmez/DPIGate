#!/sbin/openrc-run
description="DPIGate — DPI bypass with per-program filtering"
: ${GDPI_DIR:=/usr/local/lib/DPIGate}
: ${GDPI_PROGRAMS:=/etc/DPIGate/ProgramFilters}
depend() { need net; after firewall; }
start() {
    ebegin "Starting goodbyedpi"
    GDPI_PROGRAMS="$GDPI_PROGRAMS" "$GDPI_DIR/start.sh" --no-tray
    eend $?
}
stop() {
    ebegin "Stopping goodbyedpi"
    "$GDPI_DIR/kill.sh" --proc
    "$GDPI_DIR/kill.sh" --nft
    eend 0
}
